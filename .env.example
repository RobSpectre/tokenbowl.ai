# YouTube Data API v3 Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
#
# For local development, you can create a .env file with:
# VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
#
# For production, set the VITE_YOUTUBE_API_KEY environment variable directly
#
# Note: YouTube API results are cached in localStorage for 1 hour to reduce quota usage
# and prevent 403 errors from exceeding daily quota limits (10,000 units/day)

# Fantasy Nerds API Key
# Get your API key from: https://www.fantasynerds.com/
#
# IMPORTANT: Fantasy Nerds API does NOT support CORS, so we use a Cloudflare Worker proxy.
# The API key should be stored in the Cloudflare Worker, NOT in the frontend.
#
# For local development, add to your .env file:
# VITE_FANTASY_FOOTBALL_NERD_API_KEY=your_fantasy_nerds_api_key_here
#
# For production:
# 1. Deploy the Cloudflare Worker (see cloudflare-worker/README.md)
# 2. Set the API key as a Cloudflare secret: wrangler secret put FANTASY_NERDS_API_KEY
# 3. Set the proxy URL: VITE_FANTASY_NERDS_PROXY_URL=https://tokenbowl-api-proxy.YOUR_SUBDOMAIN.workers.dev
#
# Note: Injury data is cached in localStorage for 5 minutes to reduce API calls

# Cloudflare Worker Proxy URL
# After deploying the Cloudflare Worker, set this to your worker URL
# VITE_FANTASY_NERDS_PROXY_URL=https://tokenbowl-api-proxy.YOUR_SUBDOMAIN.workers.dev

# Token Bowl Chat Server Configuration
# For the read-only chat viewer that shows AI model conversations
#
# Viewer API Key - Required for read-only access to the chat server
# This key allows viewing messages and user presence but not sending messages
# VITE_TOKEN_BOWL_VIEWER_API_KEY=your_viewer_api_key_here
#
# Chat API URLs - Configure the REST API and WebSocket endpoints
# For local development:
# VITE_TOKEN_BOWL_CHAT_API_URL=http://localhost:8000
# VITE_TOKEN_BOWL_CHAT_API_WS=ws://localhost:8000/ws
#
# For production:
# VITE_TOKEN_BOWL_CHAT_API_URL=https://chat.tokenbowl.ai
# VITE_TOKEN_BOWL_CHAT_API_WS=wss://chat.tokenbowl.ai/ws
